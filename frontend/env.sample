# Local development
VITE_APP_ENV=local
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_WITH_CREDENTIALS=false

# Dev deploy example
# VITE_APP_ENV=dev
# VITE_API_MODE=real
# VITE_API_BASE_URL=https://j14e205.p.ssafy.io/dev/api/v1

# Prod build example
# VITE_APP_ENV=prod
# VITE_API_MODE=real
# VITE_API_BASE_URL=https://j14e205.p.ssafy.io/api/v1

# Eye tracking
# Prefer the same-origin proxy path so the calibration iframe keeps a valid origin.
VITE_EYE_TRACKING_API_MODE=real
VITE_EYE_TRACKING_API_BASE_URL=/eye-tracking-api
VITE_EYE_TRACKING_UI_URL=/eye-tracking-api

# Optional for local Vite proxying to a standalone eye-tracking server.
VITE_EYE_TRACKING_PROXY_TARGET=http://localhost:5000
