# Local development
VITE_APP_ENV=local
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_WITH_CREDENTIALS=false

# Dev deploy example
# VITE_APP_ENV=dev
# VITE_API_MODE=real
# VITE_API_BASE_URL=https://j14e205.p.ssafy.io/dev/api/v1
# VITE_EYE_TRACKING_API_MODE=real
# VITE_EYE_TRACKING_API_BASE_URL=/dev/eye-tracking-api
# VITE_EYE_TRACKING_UI_URL=/dev/eye-tracking-api

# Prod build example
# VITE_APP_ENV=prod
# VITE_API_MODE=real
# VITE_API_BASE_URL=https://j14e205.p.ssafy.io/api/v1
# VITE_EYE_TRACKING_API_MODE=real
# VITE_EYE_TRACKING_API_BASE_URL=/eye-tracking-api
# VITE_EYE_TRACKING_UI_URL=/eye-tracking-api

VITE_EYE_TRACKING_API_MODE=browser
VITE_EYE_TRACKING_API_BASE_URL=/eye-tracking-api
VITE_EYE_TRACKING_PROXY_TARGET=http://host.docker.internal:5000
VITE_EYE_TRACKING_UI_URL=/eye-tracking-api

# === Eye Tracking Tuning ===
# 폴링 간격 (ms, 기본 100)
# VITE_EYE_TRACKING_RUNTIME_POLL_INTERVAL_MS=100
# API 타임아웃 (ms, 기본 3000)
# VITE_EYE_TRACKING_REQUEST_TIMEOUT_MS=3000
# 커서 보간 속도 (0.01~1.0, 기본 0.15, 낮을수록 부드러움)
# VITE_GAZE_LERP_FACTOR=0.15
