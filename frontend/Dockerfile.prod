# =============================================================================
# Frontend Production Dockerfile (멀티스테이지 빌드)
# =============================================================================
# Prod 환경에서만 사용
# Stage 1: Node.js에서 빌드 → Stage 2: Nginx로 정적 파일 서빙
# =============================================================================

# Stage 1: 빌드
FROM node:22-alpine AS build
WORKDIR /app

# 의존성 먼저 설치 (캐시 최적화)
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# docker-compose에서 build.args로 전달받는 환경변수
ARG VITE_API_BASE_URL
ARG VITE_BASE_URL=/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_BASE_URL=$VITE_BASE_URL

RUN npm run build

# Stage 2: Nginx로 서빙
FROM nginx:alpine

# 헬스체크용 curl 설치
RUN apk add --no-cache curl

# 기본 nginx html 삭제 후 빌드 결과물 복사
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html

# Prod 전용 nginx 설정 복사 (캐시, 헬스체크 포함)
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
