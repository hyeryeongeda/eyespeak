# =============================================================================
# Infra Prod 데이터 서비스 환경변수 (docker-compose.data.prod.yml)
# =============================================================================
# 복사해 .env.prod 로 저장 후 값 채움
# 실행: docker compose --env-file .env.prod -f docker-compose.data.prod.yml up -d
# =============================================================================

# MYSQL
MYSQL_USER= # MYSQL 유저
MYSQL_PASSWORD= # MYSQL 유저 비밀번호

# REDIS
REDIS_PASSWORD= # REDIS 비밀번호