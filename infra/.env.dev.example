# =============================================================================
# Infra Dev 데이터 서비스 환경변수 (docker-compose.data.dev.yml)
# =============================================================================
# 복사해 .env.dev 로 저장 후 값 채움
# 실행: docker compose --env-file .env.dev -f docker-compose.data.dev.yml up -d
# =============================================================================

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=eyespeak

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
