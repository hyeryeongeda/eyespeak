pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                echo '코드 가져오기 완료'
            }
        }

        stage('Build') {
            steps {
                echo '빌드 테스트 성공'
            }
        }

        stage('Deploy') {
            steps {
                echo '배포 테스트 성공'
            }
        }
    }
}