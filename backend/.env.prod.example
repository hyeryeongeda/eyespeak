# Docker Compose 운영 서버 (docker-compose.prod.yml)
# 복사해 .env.prod 로 저장 후 값 채움
# 실행: docker-compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml --profile blue --profile green up -d

# MYSQL
MYSQL_ROOT_PASSWORD= # MYSQL ROOT 비밀번호
MYSQL_DATABASE= # MYSQL database 이름
MYSQL_USER= # MYSQL 유저
MYSQL_PASSWORD= # MYSQL 유저 비밀번호

# REDIS
REDIS_PASSWORD= # REDIS 비밀번호

# RABBITMQ
RABBITMQ_DEFAULT_USER= # RABBITMQ 유저
RABBITMQ_DEFAULT_PASS= # RABBITMQ 비밀번호

# JWT (운영은 필수, 영문 기준 32자 이상 권장)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=1800000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# AWS S3 (TTS 음성 파일 저장)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=