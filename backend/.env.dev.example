# Docker Compose 개발 서버 (docker-compose.dev.yml)
# 복사해 .env.dev 로 저장 후 값 채움
# 실행: docker-compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml --profile blue up -d

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=eyespeak

# JWT (HS256 키는 바이트 기준 충분히 길게 — 영문 기준 32자 이상 권장)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=1800000
JWT_REFRESH_TOKEN_EXPIRY=604800000
